# ===== 应用 =====
APP_NAME=ch3ngtao-web API
ENVIRONMENT=development
# JSON 数组格式
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 面向用户的时间统一按这个时区来。容器默认是 UTC，不配的话日期时间会差 8 小时。
TIMEZONE=Asia/Shanghai

# ===== 向量模型 =====
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
# true = 服务启动时就加载模型（首次会下载约 90MB）
PRELOAD_EMBEDDING_MODEL=false

# ===== 简历 FAQ（RAG）=====
# 用哪份简历（文件名相对仓库根目录，也可写绝对路径）。部署时由 compose 从 .env 注入，
# 代码里不写死；本地想用别的那份就写：RESUME_FILE=你自己的简历.pdf
RESUME_FILE=简历-李四.pdf
# 简历主人的称呼，助手提示词里会用到
RESUME_NAME=李四
# 简历 PDF 路径（比 RESUME_FILE 更优先，容器里指向挂载进去的 /app/resume.pdf），
# 两个都不填才会在「仓库根目录 / backend/data / backend」里按名字找 PDF
RESUME_PDF_PATH=
# RAG 专用向量模型，中文简历建议用中文模型；留空则复用上面的 EMBEDDING_MODEL
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# LangChain 切分粒度（字符）与相邻 chunk 重叠
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=60
# 每次问答召回的片段数量
RAG_TOP_K=5
# 向量 + BM25 混合检索（中文短查询更稳）
RAG_HYBRID=true
# 问「有哪些项目经验」这类整节问题时，把该章节的条目全部交给模型
# （一条经历常被切成多个碎片，只取 top-k 会漏条目），关掉则退回纯 top-k
RAG_SECTION_AWARE=true
# 拼给模型的片段总字符上限（章节扩展 / 条目补全时兜底，防止上下文失控）
RAG_MAX_CONTEXT_CHARS=4000
# true = 检索结果判定为「答不了」的问题转普通对话（而不是回「简历里没有找到相关信息」）
FAQ_ROUTER_ENABLED=true
# chunk 与向量的缓存文件，PDF 或切分参数变了会自动重建
RAG_CACHE_PATH=.cache/rag-index.json
# true = 服务启动时就构建索引（首次会下载中文向量模型，约 95MB）
RAG_PRELOAD=false

# ===== Agent（带工具的会话）=====
# 补充知识库（运行时可增删）的落盘位置，相对 backend 目录
AGENT_KNOWLEDGE_PATH=.cache/knowledge.json
AGENT_KNOWLEDGE_CHUNK_SIZE=400
AGENT_KNOWLEDGE_CHUNK_OVERLAP=60
# 一次提问里模型最多走多少步（一次模型调用或一次工具调用算一步）
AGENT_MAX_STEPS=8

# ===== DeepSeek 大模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2048
