# 服务器上真正用的环境变量在 env/*.env（每个环境一份，由 deploy.sh 上传成服务器 .env）。
# 这个文件是本地跑 docker compose 时用的示例：复制为 .env 再填。
#
# 本地 compose 前先建好两个环境共用的网络：
#   docker network create ch3ngtao-edge

# ---- 用哪份简历 ----
# 仓库根目录的文件名。自己的真实简历不进 git，本地跑的话它就在你机器上。
RESUME_FILE=简历-李四.pdf
RESUME_NAME=李四
# 1 = 简历数据必须生成成功，否则构建失败
RESUME_GEN_STRICT=0

# ---- 大模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 站点与端口 ----
SERVER_NAME=localhost
# 1 = 只监听 80（由别的入口转发过来）
HTTP_ONLY=0
WEB_BIND_IP=127.0.0.1
WEB_HTTP_PORT=8880
WEB_HTTPS_PORT=8443
API_PORT=8000
# 镜像名前缀，两个环境要不同
IMAGE_PREFIX=ch3ngtao-web
WEB_EDGE_ALIAS=ch3ngtao-web
EDGE_NETWORK=ch3ngtao-edge
CORS_ORIGINS=["http://localhost:8880"]

# ---- 权重下载 ----
# 服务器连不上 huggingface.co 时改成镜像：
#   HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# ---- 简历 FAQ（RAG）----
# 容器里路径固定，源文件由 RESUME_FILE 决定
RESUME_PDF_PATH=/app/resume.pdf
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 整节提问（「有哪些项目经验」）时把该章节条目全部交给模型，避免 top-k 漏条目
RAG_SECTION_AWARE=true
