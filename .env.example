# 复制为 .env 后填写，docker compose 会自动读取根目录的 .env
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 构建加速：uv 的官方镜像在 ghcr.io，国内服务器拉取可能极慢。
# 换成 ghcr 的镜像加速地址即可（换完记得重新 build）：
#   ghcr.m.daocloud.io/astral-sh/uv:latest
#   ghcr.nju.edu.cn/astral-sh/uv:latest
UV_IMAGE=ghcr.io/astral-sh/uv:latest

# 模型权重下载地址。国内服务器连不上 huggingface.co 时改成镜像：
#   HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# 简历 FAQ（RAG）：容器里通过只读挂载使用仓库根目录的简历 PDF
RESUME_PDF_PATH=/app/resume.pdf
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 整节提问（「有哪些项目经验」）时把该章节条目全部交给模型，避免 top-k 漏条目
RAG_SECTION_AWARE=true
