# 对外环境（lisi.ch3ngtao.top）：给外人看的，用仓库里的简历-李四.pdf。
# 复制为 env/public.env 后按需修改 —— 这个文件会被上传成服务器上的 .env，本身不进 git。

# ---- 镜像名：和另一个环境必须不同 ----
IMAGE_PREFIX=ch3ngtao-public

# ---- 简历：用仓库里跟踪的那份，构建时会自动生成前端数据 ----
RESUME_FILE=简历-李四.pdf
RESUME_NAME=李四
# 0 = 生成不了就退回兜底数据（这份简历是公开的，没必要卡死构建）
RESUME_GEN_STRICT=0

# ---- 对外形态 ----
# 自己不收 HTTPS：只监听 80，由入口环境（自己的那个环境）转发过来
SERVER_NAME=lisi.ch3ngtao.top
HTTP_ONLY=1
CORS_ORIGINS=["https://lisi.ch3ngtao.top"]

# ---- 端口：只在本机监听，避开入口环境占用的 80/443 ----
WEB_BIND_IP=127.0.0.1
WEB_HTTP_PORT=8081
WEB_HTTPS_PORT=8443
API_PORT=8001
WEB_EDGE_ALIAS=public-web

# ---- 其它 ----
EDGE_NETWORK=ch3ngtao-edge
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai
HF_ENDPOINT=https://hf-mirror.com

# DEEPSEEK_API_KEY 由 deploy.sh 自动补进服务器的 .env
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- RAG ----
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_SECTION_AWARE=true
RAG_MAX_CONTEXT_CHARS=4000
RAG_PRELOAD=false
FAQ_ROUTER_ENABLED=true
