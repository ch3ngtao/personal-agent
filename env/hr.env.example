# 自己的环境（ch3ngtao.top）：给 HR 看，用自己真实的简历。
# 复制为 env/hr.env 后按需修改 —— 这个文件会被上传成服务器上的 .env，本身不进 git。

# ---- 镜像名：两个环境必须不同，否则重建会把对方的镜像覆盖掉 ----
IMAGE_PREFIX=ch3ngtao-web

# ---- 简历 ----
# 文件名（放在仓库根目录）。自己的简历不进 git、也不随代码上传，
# 先执行 ./deploy.sh --env hr --upload-resume 把它传到服务器
# RESUME_FILE 优先；只填 RESUME_NAME 时按「简历-<名字>.pdf」找
# TODO 换成你自己的简历文件名（这份文件不进 git，只在本地和服务器上）
RESUME_FILE=简历-示例.pdf
RESUME_NAME=示例
# 1 = 简历数据生成失败就让构建失败（真实简历用这个，避免悄悄用错数据）
RESUME_GEN_STRICT=1

# ---- 对外形态 ----
# 这台机器上由这个环境收 HTTPS，并顺手把子域名转发给对外环境
SERVER_NAME=ch3ngtao.top www.ch3ngtao.top
HTTP_ONLY=0
EXTRA_SERVER_NAME=lisi.ch3ngtao.top
EXTRA_UPSTREAM=public-web:80
CORS_ORIGINS=["https://ch3ngtao.top","https://www.ch3ngtao.top"]

# ---- 端口：两个环境必须错开（80/443 只能被一个环境占用）----
WEB_BIND_IP=0.0.0.0
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
API_PORT=8000
# 在共用网络里的名字（对面环境转发过来的目标）
WEB_EDGE_ALIAS=ch3ngtao-web

# ---- 其它 ----
EDGE_NETWORK=ch3ngtao-edge
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai
# 国内服务器拉 ghcr 很慢，用加速地址
UV_IMAGE=ghcr.m.daocloud.io/astral-sh/uv:latest
# 服务器连不上 huggingface.co，走国内镜像
HF_ENDPOINT=https://hf-mirror.com

# 大模型：简历数据生成、FAQ 问答、Agent 都用它
# DEEPSEEK_API_KEY 由 deploy.sh 自动补进服务器的 .env（本地 backend/.env 里那份）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- RAG ----
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_SECTION_AWARE=true
RAG_MAX_CONTEXT_CHARS=4000
RAG_PRELOAD=false
FAQ_ROUTER_ENABLED=true
